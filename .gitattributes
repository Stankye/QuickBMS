# Preserve the exact bytes of the imported archives, including line endings.
/src/** -text
/scripts/** -text

# Keep repository documentation consistent across platforms.
/README.md text eol=lf
/.gitattributes text eol=lf
/Dockerfile text eol=lf
/.dockerignore text eol=lf
/.gitignore text eol=lf
/.github/** text eol=lf
/tests/** text eol=lf
/tools/** text eol=lf
